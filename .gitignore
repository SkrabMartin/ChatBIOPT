# Planning/working notes at the repo root (e.g. the project blueprint) stay local; only README is published.
/*.md
!/README.md

# Secrets & local config
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
coverage/
*.local
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.sw?

# Local object store / worker heartbeat (backend/var when run outside Docker)
var/
