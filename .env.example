# Copy to `.env` and adjust. Never commit real secrets; `.env` is git-ignored.

# --- Docker Compose ---
POSTGRES_USER=bioresearch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bioresearch
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- Backend (also read from backend/.env when running outside Docker) ---
APP_ENV=development
LOG_LEVEL=INFO
# Compose builds DATABASE_URL from the POSTGRES_* values above; set it explicitly for local runs:
# DATABASE_URL=postgresql+psycopg://bioresearch:change-me@localhost:5432/bioresearch
# TEST_DATABASE_URL=postgresql+psycopg://bioresearch:change-me@localhost:5432/bioresearch_test

# --- PubMed / NCBI E-utilities ---
# NCBI asks clients to send a contact email. An API key (free, from your NCBI account settings) raises the
# limit from 3 to 10 requests/s. Both are optional.
NCBI_EMAIL=
NCBI_API_KEY=

# --- Models (see backend/model_registry.yaml) ---
# Ollama endpoint when the backend runs outside Docker; Compose sets it (host or compose.ai.yaml service).
# OLLAMA_BASE_URL=http://localhost:11434
# Profiles with data_policy: external (hosted APIs) stay unusable unless this is true.
ALLOW_EXTERNAL_MODELS=false

# --- Evidence ingestion (worker) ---
# Full text is stored only when Europe PMC marks it open access AND its license is in this list
# (canonical ids: CC0, CC-BY, CC-BY-SA, CC-BY-ND, CC-BY-NC, CC-BY-NC-SA, CC-BY-NC-ND). Abstracts are always kept.
FULLTEXT_ALLOWED_LICENSES=CC0,CC-BY,CC-BY-SA,CC-BY-ND,CC-BY-NC,CC-BY-NC-SA,CC-BY-NC-ND
